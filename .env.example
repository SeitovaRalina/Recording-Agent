# Mila canary only. Copy to a protected service environment; never commit real values.

# Docker Compose database (fresh test DB, durable named volume)
POSTGRES_DB=recording_agent_test
POSTGRES_USER=recording_agent
POSTGRES_PASSWORD=<test-database-password>
POSTGRES_PORT=5433

# Yandex OAuth (operator-provisioned, per-recruiter credentials)
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
YANDEX_REFRESH_TOKENS={"test-recruiter@effective.band":"<refresh-token>"}
YANDEX_CALDAV_PASSWORDS={"test-recruiter@effective.band":"<Yandex app password>"}

# Legacy scan fields remain aligned with the Backend-owned 18:00 local summary.
SCAN_HOUR=18
SCAN_MINUTE=0
SCAN_IGNORE_BEFORE_TODAY=true
SCAN_LOCAL_TIMEZONE=Asia/Omsk
RECORDING_FILENAME_TIMEZONE=Europe/Moscow

# Notion
NOTION_TOKEN=
NOTION_NAME_PROP=Name
NOTION_DATE_PROP=General Interview Date
NOTION_RECORDING_PROP=General Interview recording
NOTION_CONTACTS_PROP=TBD
NOTION_PROJECT_PROP=📍 Spots
NOTION_PROJECT_PROP_TYPE=relation
NOTION_INTERVIEW_TYPE=general_interview
NOTION_WRITES_ENABLED=false

# Mattermost DM-only canary
MATTERMOST_DELIVERY_ENABLED=false
MATTERMOST_URL=
MATTERMOST_BOT_TOKEN=
MATTERMOST_BOT_USER_ID=

# Optional production storage. Canary keeps STORAGE_PROVIDER=minio; values stay blank.
SYNOLOGY_BASE_URL=
SYNOLOGY_API_KEY=
SYNOLOGY_USER=
SYNOLOGY_PASS=
SYNOLOGY_DISCOVERY_MAX_DEPTH=3
SYNOLOGY_DISCOVERY_MAX_PAGES=10
SYNOLOGY_DISCOVERY_MAX_RESULTS=100

# MinIO test storage only
MINIO_ROOT_USER=<test-minio-access-key>
MINIO_ROOT_PASSWORD=<test-minio-secret-key>
MINIO_BUCKET=recording-agent-test
MINIO_TEST_PREFIX=test-interviews
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# OpenClaw skill -> loopback Backend authentication
OPENCLAW_SECRET=<random-test-backend-secret>
REVIEW_TOKEN_TTL_SECONDS=900
QUESTION_CAPABILITY_TTL_SECONDS=90000
INTENT_CLAIM_TTL_SECONDS=900

# Canary resource boundaries (JSON arrays)
TEST_RECRUITER_ALLOWLIST=["test-recruiter@effective.band"]
TEST_NOTION_DATABASE_ALLOWLIST=["<test-notion-database-id>"]
TEST_MATTERMOST_USER_ALLOWLIST=["<test-mattermost-user-id>"]

# Pipeline
CONFIDENCE_THRESHOLD=0.7
TEST_MODE_ENABLED=true
SCHEDULER_ENABLED=false
YANDEX_SOURCE_MUTATION_ENABLED=false
CLEANUP_PREVIEW_TTL_SECONDS=600
CLEANUP_PREVIEW_MAX_ITEMS=50

# Backend HTTP port on host
APP_PORT=18000
# Structured pipeline trace stays disabled in canary.
APP_ENVIRONMENT=test
PIPELINE_TRACE_ENABLED=false
