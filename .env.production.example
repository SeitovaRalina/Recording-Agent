# Secretless template for /etc/recording-agent/backend.env (mode 0600, root-owned).
# Replace every <required-...> value on the server. Never use this file as a runtime env file.

APP_ENVIRONMENT=production
APP_PORT=18000
PIPELINE_TRACE_ENABLED=false
TEST_MODE_ENABLED=false
SCHEDULER_ENABLED=false
AUTONOMOUS_ROUTING_ENABLED=false
NOTION_WRITES_ENABLED=false
YANDEX_SOURCE_MUTATION_ENABLED=false
MATTERMOST_DELIVERY_ENABLED=false

# Images are deployed by immutable digest only.
RECORDING_AGENT_IMAGE=ghcr.io/seitovaralina/recording-agent@sha256:<required-64-hex-digest>
POSTGRES_IMAGE=postgres@sha256:<required-64-hex-digest>
# Mihomo image must be pinned by digest and include `mihomo`, `curl`, and a POSIX shell.
# Build/deploy route mounts only the reviewed proxy assets.
MIHOMO_IMAGE=ghcr.io/metacubex/mihomo@sha256:<required-64-hex-digest>

POSTGRES_DB=recording_agent
POSTGRES_USER=recording_agent
POSTGRES_PASSWORD=<required-random-password>
DATABASE_URL=postgresql+asyncpg://recording_agent:<required-url-encoded-password>@postgres:5432/recording_agent

YANDEX_CLIENT_ID=<required-client-id>
YANDEX_CLIENT_SECRET=<required-client-secret>
YANDEX_REFRESH_TOKENS={"recruiter@example.com":"<required-refresh-token>"}
YANDEX_CALDAV_PASSWORDS={"recruiter@example.com":"<required-app-password>"}
CALDAV_BASE_URL=https://caldav.yandex.ru

SCAN_HOUR=18
SCAN_MINUTE=0
SCAN_IGNORE_BEFORE_TODAY=true
SCAN_LOCAL_TIMEZONE=Asia/Omsk
RECORDING_FILENAME_TIMEZONE=Europe/Moscow

NOTION_TOKEN=<required-notion-token>
# Backend sends only Notion API traffic through this internal sidecar endpoint.
NOTION_PROXY_URL=http://notion-proxy:7890
# `VPN_SUB_URL` exists only in root-owned `/etc/recording-agent/notion-proxy.env`, never here.
NOTION_NAME_PROP=Name
NOTION_DATE_PROP=General Interview Date
NOTION_RECORDING_PROP=General Interview recording
NOTION_CONTACTS_PROP=TBD
NOTION_PROJECT_PROP=📍 Spots
NOTION_PROJECT_PROP_TYPE=relation
NOTION_INTERVIEW_TYPE=general_interview

STORAGE_PROVIDER=synology
SYNOLOGY_BASE_URL=<required-https-url>
SYNOLOGY_API_KEY=<required-api-key>
SYNOLOGY_USER=
SYNOLOGY_PASS=
SYNOLOGY_DEVICE_ID=
SYNOLOGY_INTERVIEW_ROOTS=["<required-allowed-interview-root-1>","<required-allowed-interview-root-2>"]
SYNOLOGY_DISCOVERY_MAX_DEPTH=3
SYNOLOGY_DISCOVERY_MAX_PAGES=10
SYNOLOGY_DISCOVERY_MAX_RESULTS=100
# Links are public and permanent by product policy; no password or expiry is configured.

MATTERMOST_URL=<required-https-url>
MATTERMOST_BOT_TOKEN=<required-recordings-saver-bot-token>
MATTERMOST_BOT_USER_ID=<required-recordings-saver-bot-user-id>

OPENCLAW_SECRET=<required-random-backend-secret>
REVIEW_TOKEN_TTL_SECONDS=900
QUESTION_CAPABILITY_TTL_SECONDS=90000
INTENT_CLAIM_TTL_SECONDS=900
CONFIDENCE_THRESHOLD=0.7
CLEANUP_PREVIEW_TTL_SECONDS=600
CLEANUP_PREVIEW_MAX_ITEMS=50

# Canary boundaries remain mandatory until separately approved.
TEST_RECRUITER_ALLOWLIST=["recruiter@example.com"]
TEST_NOTION_DATABASE_ALLOWLIST=["<required-test-database-id>"]
TEST_MATTERMOST_USER_ALLOWLIST=["<required-allowlisted-user-id>"]

# Rollout: provision Backend proxy URL and image digest here; provision `VPN_SUB_URL` only in
# root-owned `/etc/recording-agent/notion-proxy.env`, then deploy reviewed release.
# Rollback: use `sudo /usr/local/sbin/recording-agent-rollback`; it restores prior proxy assets too.
