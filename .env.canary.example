# Copy outside Git to /etc/recording-agent/canary/backend.env (root:root, 0600).
# Test-only values. Never reuse production credentials, database names, or IDs.
POSTGRES_IMAGE=postgres@sha256:<pinned-postgres-digest>
RECORDING_AGENT_IMAGE=ghcr.io/seitovaralina/recording-agent@sha256:<candidate-digest>
MIHOMO_IMAGE=ghcr.io/metacubex/mihomo@sha256:<pinned-mihomo-digest>
POSTGRES_DB=recording_agent_canary
POSTGRES_USER=recording_agent_canary
POSTGRES_PASSWORD=<test-only-password>
DATABASE_URL=postgresql+asyncpg://recording_agent_canary:<test-only-password>@postgres:5432/recording_agent_canary
NOTION_TOKEN=<test-integration-token>
NOTION_NAME_PROP=Name
NOTION_DATE_PROP=General Interview Date
NOTION_RECORDING_PROP=General Interview recording
NOTION_CONTACTS_PROP=Contacts
NOTION_PROJECT_PROP=Project
NOTION_PROJECT_PROP_TYPE=relation
TEST_MODE_ENABLED=true
TEST_RECRUITER_ALLOWLIST=["test-recruiter@example.invalid"]
TEST_NOTION_DATABASE_ALLOWLIST=["<test-notion-database-id>"]
SCHEDULER_ENABLED=false
AUTONOMOUS_ROUTING_ENABLED=false
NOTION_WRITES_ENABLED=false
MATTERMOST_DELIVERY_ENABLED=false
YANDEX_SOURCE_MUTATION_ENABLED=false
STORAGE_PROVIDER=minio
PIPELINE_TRACE_ENABLED=false
APP_PORT=18001
